# Variáveis de produção. No Coolify elas são preenchidas na aba Environment Variables.
# Fora do Coolify: copie para .env.prod (fica fora do Git) e rode
#   docker compose -f docker-compose.prod.yaml --env-file .env.prod up -d --build

# Obrigatória. Só letras e números (ex.: gerada com "openssl rand -hex 24").
POSTGRES_PASSWORD=

# Primeiro admin, criado no primeiro deploy. Troque a senha depois em "Minha conta".
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: WhatsApp da barbearia com DDI e DDD, só números (ex.: 5511999999999).
WHATSAPP_NUMBER=

# Opcional: fuso da barbearia.
SHOP_TIMEZONE=America/Sao_Paulo
