# Endereço da API (NestJS). No Docker Compose de produção vira http://api:3333.
API_URL=http://localhost:3333

# Fuso da barbearia. Precisa ser igual ao SHOP_TIMEZONE da API.
SHOP_TIMEZONE=America/Sao_Paulo

# Opcional: WhatsApp da barbearia com DDI e DDD, só números (ex.: 5511999999999).
# Quando preenchido, os horários livres da página inicial viram links para o WhatsApp.
WHATSAPP_NUMBER=
