# Copie este arquivo para .env e ajuste os valores.

# Ambiente: development, test ou production
NODE_ENV=development
PORT=3333

# Banco do docker compose da raiz do projeto
DATABASE_URL=postgresql://vikings:vikings@localhost:5432/vikings_barber

# Fuso horário da barbearia (horários de funcionamento e agenda)
SHOP_TIMEZONE=America/Sao_Paulo

# Duração da sessão de login, em horas (168 = 7 dias)
SESSION_TTL_HOURS=168

# Limite geral de requisições por minuto, por IP
RATE_LIMIT_PER_MINUTE=300

# De quais proxies a API aceita o cabeçalho X-Forwarded-For (formato do Express "trust proxy")
TRUST_PROXY=loopback, linklocal, uniquelocal

# Documentação Swagger em /docs (por padrão fica desligada em produção)
SWAGGER_ENABLED=true

# Primeiro admin, criado pelo `npm run db:seed`
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@vikingsbarber.local
ADMIN_PASSWORD=troque-esta-senha

# Dados de demonstração no seed (só fora de produção)
SEED_DEMO_DATA=true
DEMO_PASSWORD=barbeiro-demo-123
